<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Matteo_Hubert_App.ViewModels"
             x:Class="Matteo_Hubert_App.DetailsPage"
             Title="Détails">

    <ContentPage.BindingContext>
        <vm:DetailsViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="20" Spacing="10">
        <Label Text="{Binding CurrentGame.Name}" FontSize="22" FontAttributes="Bold" />

        <Label Text="Genre :" FontAttributes="Bold" FontSize="14"/>
        <Label Text="{Binding CurrentGame.GenreDisplay}" />

        <Label Text="Développeurs :" FontAttributes="Bold" FontSize="14" Margin="0,10,0,0" />
        <Label Text="{Binding CurrentGame.DevelopersDisplay}" />

        <Label Text="Éditeurs :" FontAttributes="Bold" FontSize="14" Margin="0,10,0,0" />
        <Label Text="{Binding CurrentGame.PublishersDisplay}" />

        <Label Text="Date de sortie :" FontAttributes="Bold" FontSize="14" Margin="0,10,0,0" />    
        <Label Text="{Binding CurrentGame.ReleaseDateDisplay}" />
    </VerticalStackLayout>

</ContentPage>