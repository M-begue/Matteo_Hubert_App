<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Matteo_Hubert_App.ViewModels"
             x:Class="Matteo_Hubert_App.MainPage"
             Title="Accueil">

    <ContentPage.BindingContext>
        <vm:MainViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25">
            
            <Label Text="Matteo Hubert App" Style="{StaticResource Headline}" HorizontalOptions="Center" />
            
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Image Grid.Column="0" Source="im_all_ears.png" HeightRequest="150" Aspect="AspectFill" />
                <Image Grid.Column="1" Source="triple_t.png" HeightRequest="150" Aspect="AspectFill" />
            </Grid>

            <Button Text="Voir l'animation GIF" Command="{Binding OpenGifPageCommand}" 
                    BackgroundColor="#512BD4" TextColor="White" CornerRadius="10" />

            <Label Text="Jeux Switch de l'API :" FontAttributes="Bold" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <CarouselView ItemsSource="{Binding Games}" HeightRequest="200">
                <CarouselView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="10" StrokeShape="RoundRectangle 10" BackgroundColor="#F0F0F0">
                            <VerticalStackLayout Padding="10" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                                <Label Text="{Binding GenreDisplay}" FontSize="12" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>