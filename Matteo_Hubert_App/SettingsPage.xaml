<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Matteo_Hubert_App.SettingsPage"
             Title="Compteur de jeux">

    <VerticalStackLayout Padding="20" Spacing="20">
        
        <Border BackgroundColor="#F0F0F0" Padding="15">
            <VerticalStackLayout Spacing="5">
                <Label Text="Statistiques" FontSize="18" FontAttributes="Bold" />
                <HorizontalStackLayout Spacing="5">
                    <Label Text="Total de jeux affichés :" VerticalOptions="Center" />
                    <Label Text="{Binding Games.Count}" FontSize="20" TextColor="#512BD4" FontAttributes="Bold" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <Label Text="Actions" FontSize="18" FontAttributes="Bold" Margin="0,10,0,0" />
        
        <Button Text="Supprimer la liste (Reset)" 
                Command="{Binding ClearGamesCommand}"
                BackgroundColor="Red" 
                TextColor="White" />

        <Button Text="Recharger l'API" 
                Command="{Binding LoadGamesCommand}"
                BackgroundColor="#512BD4" 
                TextColor="White" />

        <Label Text="Note : Supprimer la liste permet d'enlever tous les jeux (API et manuels)"
               FontSize="12" HorizontalTextAlignment="Center" Margin="0,20,0,0" />
        
    </VerticalStackLayout>
</ContentPage>